                                    <buttonCell key="cell" type="check" title="Transliterate non-ASCII share names in mount paths" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="1Ve-Rb-a0Z">
                                        <behavior key="behavior" changeContents="YES" doesNotDimImage="YES" lightByContents="YES"/>
